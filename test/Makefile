# Test Makefile
TEST_TARGET = ../build/test_runner
CC = clang
CFLAGS = -Wall -Wextra -O2 -std=c99 -I../src -MMD -MP `llvm-config --cflags`
LDFLAGS = `llvm-config --ldflags --libs --system-libs`

# Get LLVM library directory for runtime linking
LLVM_LIBDIR = $(shell llvm-config --libdir)

# Source files
TEST_SRCS = $(wildcard *.c)
PRODUCT_SRCS = $(filter-out ../src/main.c, $(wildcard ../src/*.c))

ALL_SRCS = $(TEST_SRCS) $(PRODUCT_SRCS)

# Keep test objects separate: dependency paths and flags differ from the root build.
BUILD_DIR = ../build/test

# Object files - auto-generated from sources
TEST_OBJS = $(patsubst %.c,$(BUILD_DIR)/test_%.o,$(TEST_SRCS))
PRODUCT_OBJS = $(patsubst ../src/%.c,$(BUILD_DIR)/%.o,$(PRODUCT_SRCS))
ALL_OBJS = $(PRODUCT_OBJS) $(TEST_OBJS)

# Dependency files (.d files are auto-generated by compiler with -MMD flag)
DEPS = $(ALL_OBJS:.o=.d)

# Default target
.PHONY: all test run clean format
all: $(TEST_TARGET)

# Include generated dependency files
-include $(DEPS)

test run: $(TEST_TARGET)
	@LD_LIBRARY_PATH=$(LLVM_LIBDIR):$$LD_LIBRARY_PATH $(TEST_TARGET)

# Build test executable
$(TEST_TARGET): $(ALL_OBJS) | $(BUILD_DIR)
	@echo "Building test runner..."
	$(CC) $(CFLAGS) -o $(TEST_TARGET) $(ALL_OBJS) $(LDFLAGS)
	@chmod +x $(TEST_TARGET)

# Product object files
$(BUILD_DIR)/%.o: ../src/%.c | $(BUILD_DIR)
	@echo $(CC) $(CFLAGS) -c $< -o $@
	$(CC) $(CFLAGS) -c $< -o $@

# Test object files
$(BUILD_DIR)/test_%.o: %.c | $(BUILD_DIR)
	@echo $(CC) $(CFLAGS) -c $< -o $@
	$(CC) $(CFLAGS) -c $< -o $@

# Build directory
$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

# Clean
clean:
	rm -rf $(BUILD_DIR) $(TEST_TARGET)
	rm -f ../build/test_*.o ../build/test_*.d

# Format
format:
	clang-format -i $(ALL_SRCS)
